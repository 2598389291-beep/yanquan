# ============================================================
# 言权后端配置（复制为 .env 后修改）
# cp .env.example .env
# ============================================================

# ---- 核心服务 ----
# 阿里云百炼 API Key（通义千问 LLM + ASR + OCR）
# 申请：https://bailian.console.aliyun.com/
# 留空或使用占位符时，系统自动进入【演示模式】：
#   投诉信生成走纯规则管线（无需任何外部服务），语音/OCR 能力关闭并给出友好提示
DASHSCOPE_API_KEY=

# ---- 微信小程序登录（上线后必填）----
# 获取：微信公众平台 mp.weixin.qq.com → 开发管理 → 开发设置
WECHAT_APPID=
WECHAT_SECRET=

# ---- 运营管理员 ----
# 首次上线时填写你的登录用户 ID；只有该账号可进入运营接口并给其他账号分配角色
ADMIN_USER_ID=

# ---- 服务监听 ----
HOST=0.0.0.0
PORT=8000
# CORS 允许来源，逗号分隔；开发环境可用 *
CORS_ORIGINS=*
# development / production
ENVIRONMENT=development

# ---- LLM 配置 ----
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# ---- ASR 配置 ----
ASR_MODEL=paraformer-realtime-v2

# ---- 外部法律 API（预留：北大法宝等）----
# 启用后，法律检索优先调用外部 API，失败时自动回退本地知识库
# EXTERNAL_LAW_API_ENABLED=true
# EXTERNAL_LAW_API_URL=https://api.pkulaw.com/xxx
# EXTERNAL_LAW_API_KEY=your_api_key
